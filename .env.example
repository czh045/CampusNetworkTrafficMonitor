# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-this-password
DB_NAME=campus_traffic

# Optional DingTalk alert notifications. Leave blank to disable notifications.
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=
ALERT_NOTIFY_INTERVAL_MINUTES=15
ALERT_NOTIFY_MAX_COUNT=3

# Keep false in local development unless you deliberately want the background
# alert polling thread to run.
ENABLE_ALERT_CHECKER=false

# Used by scripts/bootstrap_admin.py. This value is not read by the web app.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running-the-script
